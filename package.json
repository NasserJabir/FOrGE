{
  "name": "forge",
  "version": "0.1.0",
  "description": "FOrGE — agent-agnostic, model-agnostic, provider-independent governance and truth substrate (FORGE-SRS-1.0)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:provocation": "vitest run --dir tests/provocation",
    "test:property": "vitest run --dir tests/property",
    "ci": "npm run lint && npm run format && npm run build && npm run test:coverage && tsx scripts/ci-guards.ts",
    "cli": "tsx src/cli/index.ts"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "ulid": "^3.0.2",
    "zod": "^4.5.1"
  }
}
